#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip {
    chain-length = <11>;
};

/ {
    macros {
        SUM: SUM {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp S &kp U &kp M &kp EQUAL &kp LPAR &kp RPAR &kp RIGHT>
                ;
        };
    };
};

/ {
    behaviors {
        bhm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;    // <---[[moderate duration]]
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };
};
/{
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -------------------------------------------------------------------------------------
// |  TAB | Q      | D      | R       | W        |  B  |   |  J  |  F        |  U       |  P      |  ;     |    -   |
// | CTRL | A(GUI) | S(Alt) | H(Ctrl) | T(shift) |  G  |   |  Y  |  N(shift) |  E(Ctrl) |  O(Alt) | I(GUI) | '      |
// | SHFT | Z      | X      | M       | C        |  V  |   |  K  |  L        |  ,       |  .      |  /     | RETURN |
//                                      | DEL | LWR |  SPC  | RSE  | BSPC |
                        bindings = <
   &kp TAB   &kp Q &kp D &kp R &kp W         &kp B   &kp J &kp F        &kp U     &kp P    &kp SEMI &kp MINUS
   &kp LCTRL &bhm LGUI A &bhm LALT S &bhm LCTRL H &bhm LSHIFT T &kp G   &kp Y &bhm RSHFT N &bhm RCTRL E &bhm RALT O &bhm RGUI I    &kp SQT
   &kp LSHFT &kp Z &kp X &kp M &kp C         &kp V   &kp K &kp L        &kp COMMA &kp DOT  &kp FSLH &kp RETURN
                       &kp DEL  &mo 1 &kp SPACE &mo 2  &kp BSPC
                        >;
                };

                lower_layer {
// ------------------------------------------------------------------------------------
// | ESC |  !  |  @  |  #  |  $  | %   |   |  ^  |  &   |   *  | (   |  )  | DEL    |
// |     |  _  |  +  |  {  |  }  | "|" |   |  `  | LEFT | DOWN | UP  | RGT |  ~     |
// |     | Undo| Cut |Copy |Paste| Find|   | PRSC| HOME | PGUP | PGDN| END | SHFT(SPACE) |
//                       |     |     | RET | ADJ |     |
                        bindings = <
   &kp ESC &kp EXCL  &kp AT      &kp HASH  &kp DLLR  &kp PRCNT      &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp DEL
   &trans  &kp UNDER &kp PLUS    &kp LBRC  &kp RBRC  &kp PIPE       &kp GRAVE &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp TILDE
   &trans  &kp LC(Z) &kp LC(X)   &kp LC(C) &kp LC(V) &kp LC(F)      &kp PSCRN &kp HOME &kp PG_UP &kp PG_DN &kp END   &mt RSHFT SPACE
                                 &trans      &trans       &kp RET        &mo 3       &trans
                        >;
                };

                raise_layer {
// ----------------------------------------------------------------------------
// |    | "|" |  &  |  *  |  (   |  )  |   | =sum() | 7  |  8 | 9  | -  |   |
// |    |  [  |  $  |  %  |  ^   |  /  |   | =      | 4  | 5  | 6  | +  |   |
// |    |  ]  |  !  |  @  |  #   |  \  |   | 0      | 1  | 2  | 3  | .  |   |
//                       |     | ADJ | DEL |    |     |
                        bindings = <
   &trans &kp PIPE  &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR      &SUM       &kp N7    &kp N8    &kp N9    &kp MINUS &trans
   &trans &kp LBKT  &kp DLLR  &kp PRCNT &kp CARET &kp FSLH      &kp EQUAL  &kp N4    &kp N5    &kp N6    &kp PLUS  &trans
   &trans &kp RBKT  &kp EXCL  &kp AT    &kp HASH  &kp BSLH      &kp N0     &kp N1    &kp N2    &kp N3    &kp DOT   &trans
                                &trans      &mo 3       &kp DEL        &trans      &trans
                        >;
                };

                adjust_layer {
// -----------------------------------------------------------------------------------------
// | RGB BRI+ | RGB SAT+ | RGB HUE+ | RGB ANI+ |    | RGB TOG |   |  BT1    | BT2        | BT3 | BT4 | BT5 | BT CLR |
// | RGB BRI- | RGB SAT- | RGB HUE- | RGB ANI- |    |         |   | Studio  |            |     |     |     |        |
// |          |          |          |          |    |  RESET  |   |SOFT OFF | Bootloader |     |     |     |        |
//                                               |     |     |     |     |     |
                        bindings = <
   &rgb_ug RGB_BRI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_EFF &none &rgb_ug RGB_TOG &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
   &rgb_ug RGB_BRD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_EFR &none &studio_unlock  &none        &none        &none        &none        &none        &none
   &none           &none           &none           &none           &none &sys_reset      &soft_off   &bootloader  &none        &none        &none        &none
                                                             &trans      &trans       &tog 3        &trans      &trans
                        >;
                };
        };
};
